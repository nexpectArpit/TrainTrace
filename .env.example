# Export these in the shell before starting the API; .env is not loaded automatically.
# Leave storage/data unset for the default managed directories.
# TRAINTRACE_STORAGE_DIR=/absolute/path/to/traintrace-storage
# TRAINTRACE_DATA_DIR=/absolute/path/to/cached-cifar-data
# TRAINTRACE_DEVICE=cpu
TRAINTRACE_CPU_THREADS=4
TRAINTRACE_WORKER=1
